[Unit]
Description=Botsaz - Tenant VPN-only worker (PHASE 0 TEST — no nginx wiring yet)
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/botsaz
EnvironmentFile=/opt/botsaz/.env
# === PATCH_TENANT_WORKER_KIND_V1 ===
# فقط همین متغیر با سرویسِ اصلی فرق دارد؛ همان main_tenant:app، همان کد.
Environment=TENANT_BOT_KIND=vpn
ExecStart=/opt/botsaz/venv/bin/uvicorn main_tenant:app --host 127.0.0.1 --port 8011
Restart=on-failure
RestartSec=3
StartLimitIntervalSec=60
StartLimitBurst=5

[Install]
WantedBy=multi-user.target
