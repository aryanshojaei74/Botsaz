[Unit]
Description=Botsaz - Tenant virtual_service (SMM) worker
After=network.target postgresql.service
Wants=postgresql.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=root
WorkingDirectory=/opt/botsaz
EnvironmentFile=/opt/botsaz/.env
Environment=TENANT_BOT_KIND=virtual_service
ExecStart=/opt/botsaz/venv/bin/uvicorn main_tenant:app --host 127.0.0.1 --port 8012
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
