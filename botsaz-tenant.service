[Unit]
StartLimitIntervalSec=60
StartLimitBurst=5
Description=Botsaz - Tenant bots service
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/botsaz
EnvironmentFile=/opt/botsaz/.env
ExecStart=/opt/botsaz/venv/bin/uvicorn main_tenant:app --host 127.0.0.1 --port 8001
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
